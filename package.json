{
  "name": "teams-bug-raiser",
  "version": "1.0.0",
  "description": "Teams bot that automatically creates Azure DevOps bugs using AI",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "keywords": [
    "teams",
    "bot",
    "azure-devops",
    "bug-tracking",
    "ai"
