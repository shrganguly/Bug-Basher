# Environment Variables Template
# Copy this to .env and fill in your actual values

# ====================================
# Bot Framework Configuration
# ====================================
MICROSOFT_APP_ID=your_bot_app_id_here
MICROSOFT_APP_PASSWORD=your_bot_app_password_here
MICROSOFT_APP_TYPE=MultiTenant
MICROSOFT_APP_TENANT_ID=

# ====================================
# AI Configuration
# ====================================
# AI Provider: 'azure-openai' or 'claude' (default: azure-openai)
AI_PROVIDER=azure-openai

# Azure OpenAI Configuration (default)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Alternative: Claude API Configuration (if using Anthropic)
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ====================================
# Azure DevOps Configuration
# ====================================
# Organization name (from URL: https://dev.azure.com/{organization})
ADO_ORGANIZATION=your_org_name

# Project name (from URL: https://dev.azure.com/{org}/{project})
ADO_PROJECT=your_project_name

# Personal Access Token with Work Items: Read, Write permissions
ADO_PAT=your_personal_access_token_here

# Optional: Area Path (e.g., "YourProject\\YourArea")
ADO_AREA_PATH=

# Optional: Iteration Path (e.g., "YourProject\\Sprint 1")
ADO_ITERATION_PATH=

# ====================================
# Server Configuration
# ====================================
PORT=3000
BASE_URL=http://localhost:3000

# ====================================
# Azure Storage (for State Persistence)
# ====================================
# IMPORTANT: Without this, user configurations will be lost on every restart!
# Get connection string from Azure Portal → Storage Account → Access keys
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=bot-state

# ====================================
# Optional: Development Settings
# ====================================
NODE_ENV=development
